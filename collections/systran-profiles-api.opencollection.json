{
  "opencollection": "1.0.0",
  "info": {
    "name": "SYSTRAN Translate & NLP Corpus Profiles API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List profiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-translate.systran.net/profiles"
          },
          "docs": "List profiles"
        },
        {
          "info": {
            "name": "Create a profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-translate.systran.net/profiles/create"
          },
          "docs": "Create a profile"
        },
        {
          "info": {
            "name": "Delete a profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-translate.systran.net/profiles/delete"
          },
          "docs": "Delete a profile"
        },
        {
          "info": {
            "name": "Activate a profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-translate.systran.net/profiles/activate"
          },
          "docs": "Activate a profile"
        },
        {
          "info": {
            "name": "Deactivate a profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-translate.systran.net/profiles/deactivate"
          },
          "docs": "Deactivate a profile"
        },
        {
          "info": {
            "name": "Get profile permissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-translate.systran.net/profiles/:id/permissions",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get profile permissions"
        },
        {
          "info": {
            "name": "Update profile permissions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-translate.systran.net/profiles/:id/permissions",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update profile permissions"
        },
        {
          "info": {
            "name": "List translation resources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-translate.systran.net/translationResources"
          },
          "docs": "List translation resources"
        }
      ]
    }
  ],
  "bundled": true
}